      "type": "home-faq",
      "settings": {},
      "blocks": {
        "home_faq_b1": {
          "type": "qa",
          "settings": {
            "question": "Do I need all four books, or can I start with one?",
            "answer": "<p>You can start with any single book. The system is built to grow with your child \u2014 Imitation builds the foundation, My Words adds vocabulary, Action bridges to sentences, and My Routines applies it all to daily life. The Complete Bundle saves the most if you want the full arc.</p>",
            "open": true
          }
        },
        "home_faq_b2": {
          "type": "qa",
          "settings": {
            "question": "When does My Routines Book ship?",
            "answer": "<p>My Routines Book is currently in presale. Reserve your copy today and it will ship on [date] \u2014 presale customers get early access ahead of general availability.</p>"
          }
        },
        "home_faq_b3": {
          "type": "qa",
          "settings": {
            "question": "What age are these books for?",
            "answer": "<p>Ages 6 months through 4 years, across the four stages. Most families return to all four books at different points in that range.</p>"
          }
        },
        "home_faq_b4": {
          "type": "qa",
          "settings": {
            "question": "What about shipping and returns?",
            "answer": "<p>Bundles ship free within the US, arriving in 3\u20135 business days. Not happy with your books? Send them back within 30 days for a full refund.</p>"
          }
        }
      },
