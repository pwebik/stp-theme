{%- comment %} Final CTA — dark panel {% endcomment -%}
<section class="home-block home-final-cta">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div class="hero-ctas">
        <a href="{{ section.settings.cta_link | default: '#' }}" class="btn-primary on-coral">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section> 

{% schema %}
{
  "name": "Home · Final CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Open the books, read together, and watch the words come." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Get all four — Sounds, Words, Actions, and Routines — in one complete system." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the Complete Bundle" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Home · Final CTA" } ]
}
{% endschema %}
