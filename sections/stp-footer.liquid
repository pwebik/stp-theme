{%- comment %} Speech Therapy Publishing — brand footer (matches Genesis mockup) {% endcomment -%}
<footer class="stp-footer">
  <div class="stp-foot-wrap">
    <div class="stp-foot-grid">
      <a href="{{ routes.root_url }}" class="stp-logo stp-foot-logo">
        {%- if section.settings.logo_image != blank -%}
          {{ section.settings.logo_image | image_url: width: 300 | image_tag: alt: shop.name, class: 'stp-logo-img' }}
        {%- else -%}
          <span class="stp-logo-dot" aria-hidden="true"></span>{{ section.settings.logo_text }} <em>{{ section.settings.logo_text_accent }}</em>
        {%- endif -%}
      </a>

      <div class="stp-foot-cols">
        {%- for block in section.blocks -%}
          <div class="stp-foot-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h5>{{ block.settings.heading }}</h5>{%- endif -%}
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="stp-foot-bottom">© {{ 'now' | date: "%Y" }} {{ section.settings.copyright }}</div>
  </div>
</footer>

{% stylesheet %}
.stp-footer { padding: 60px 0 40px; background: var(--cream, #FDF3E2); }
.stp-foot-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
.stp-foot-grid { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 24px; border-top: 1px solid var(--line, rgba(43,36,64,0.1)); padding-top: 36px; }
.stp-foot-logo { font-family: var(--font-heading-family); font-weight: 700; font-size: 19px; color: var(--ink, #262138); text-decoration: none; }
.stp-foot-logo .stp-logo-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--coral, #F4901E); display: inline-block; margin-right: 8px; }
.stp-foot-logo em { font-style: normal; color: var(--coral-deep, #DE7B0E); }
.stp-foot-cols { display: flex; gap: 64px; flex-wrap: wrap; }
.stp-foot-col h5 { font-family: var(--font-body-family); font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-soft, #635D74); margin: 0 0 14px; }
.stp-foot-col a { display: block; font-size: 14px; font-weight: 600; color: var(--ink, #262138); margin-bottom: 10px; text-decoration: none; }
.stp-foot-col a:hover { color: var(--coral-deep, #DE7B0E); }
.stp-foot-bottom { margin-top: 40px; font-size: 13px; color: var(--ink-soft, #635D74); }
@media (max-width: 980px) { .stp-foot-cols { gap: 40px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "STP Footer",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Logo image (optional — overrides text logo)" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "speech therapy" },
    { "type": "text", "id": "logo_text_accent", "label": "Logo text (accent)", "default": "publishing" },
    { "type": "text", "id": "copyright", "label": "Copyright text (year is added automatically)", "default": "Speech Therapy Publishing. All rights reserved." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "enabled_on": { "groups": ["footer"] },
  "presets": [
    {
      "name": "STP Footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "Shop" } },
        { "type": "column", "settings": { "heading": "Company" } },
        { "type": "column", "settings": { "heading": "New" } }
      ]
    }
  ]
}
{% endschema %}
