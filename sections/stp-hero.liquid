{%- comment -%}  STP Hero — homepage thesis section  {%- endcomment -%}
<section class="stp-block stp-hero" aria-label="{{ section.settings.heading | escape }}">
  {%- if section.settings.show_doodles -%}
    {% render 'stp-doodle', type:'star',    color:'var(--stp-yellow)', size:46, float:'stp-float',               style:'top:11%;left:4%;--r:-8deg' %}
    {% render 'stp-doodle', type:'heart',   color:'var(--stp-pink)',   size:30, float:'stp-float stp-float--slow', style:'top:64%;left:44%;--r:12deg' %}
    {% render 'stp-doodle', type:'swirl',   color:'var(--stp-teal)',   size:38, float:'stp-float stp-float--fast', style:'top:20%;right:46%;--r:-6deg' %}
    {% render 'stp-doodle', type:'crescent',color:'var(--stp-purple)', size:26, float:'stp-float',               style:'bottom:14%;right:6%;--r:18deg' %}
    {% render 'stp-doodle', type:'sparkle', color:'var(--stp-orange)', size:30, float:'stp-float stp-float--slow', style:'top:8%;right:16%;--r:0deg' %}
  {%- endif -%}

  <div class="stp-wrap">
    <div class="stp-hero__grid">
      <div class="stp-hero__copy">
        {%- if section.settings.eyebrow != blank -%}<span class="stp-pill stp-pill--teal">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1 class="stp-hero__title">
          {{ section.settings.heading }}
          {%- if section.settings.heading_highlight != blank -%}<em>{{ section.settings.heading_highlight }}</em>{%- endif -%}
        </h1>
        {%- if section.settings.subheading != blank -%}<p class="stp-hero__lede">{{ section.settings.subheading }}</p>{%- endif -%}
        <div class="stp-hero__ctas">
          {%- if section.settings.cta_primary_label != blank -%}<a href="{{ section.settings.cta_primary_link | default: '#' }}" class="stp-btn stp-btn--cta">{{ section.settings.cta_primary_label }}</a>{%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}<a href="{{ section.settings.cta_secondary_link | default: '#' }}" class="stp-btn stp-btn--ghost">{{ section.settings.cta_secondary_label }}</a>{%- endif -%}
        </div>
        <div class="stp-hero__badges">
          {%- if section.settings.badge_1 != blank -%}<span class="stp-pill stp-pill--orange">{{ section.settings.badge_1 }}</span>{%- endif -%}
          {%- if section.settings.badge_2 != blank -%}<span class="stp-pill stp-pill--pink">{{ section.settings.badge_2 }}</span>{%- endif -%}
        </div>
      </div>

      <div class="stp-hero__art">
        <div class="stp-hero__frame">
          {%- if section.settings.single_image != blank -%}
            <img class="stp-hero__single" src="{{ section.settings.single_image | image_url: width: 1200 }}" alt="{{ section.settings.single_image.alt | default: 'The book collection' | escape }}" fetchpriority="high" loading="eager">
          {%- else -%}
            <div class="stp-hero__covers">
              <div class="stp-hero__cell" style="--book:var(--stp-orange)">
                <img src="{% if section.settings.cover_1 != blank %}{{ section.settings.cover_1 | image_url: width: 500 }}{% else %}{{ 'stp-imitation-front.webp' | asset_url }}{% endif %}" alt="Imitation Book" loading="eager" fetchpriority="high">
                <span class="stp-hero__cap">Sounds</span>
              </div>
              <div class="stp-hero__cell" style="--book:var(--stp-pink)">
                <img src="{% if section.settings.cover_2 != blank %}{{ section.settings.cover_2 | image_url: width: 500 }}{% else %}{{ 'stp-mywords-front.webp' | asset_url }}{% endif %}" alt="My Words Book" loading="eager">
                <span class="stp-hero__cap">Words</span>
              </div>
              <div class="stp-hero__cell" style="--book:var(--stp-red)">
                <img src="{% if section.settings.cover_3 != blank %}{{ section.settings.cover_3 | image_url: width: 500 }}{% else %}{{ 'stp-action-3d.webp' | asset_url }}{% endif %}" alt="Action Book" loading="eager">
                <span class="stp-hero__cap">Sentences</span>
              </div>
              <div class="stp-hero__cell" style="--book:var(--stp-purple)">
                <span class="stp-hero__new">NEW</span>
                <img src="{% if section.settings.cover_4 != blank %}{{ section.settings.cover_4 | image_url: width: 500 }}{% else %}{{ 'stp-routines-front.webp' | asset_url }}{% endif %}" alt="My Routines Book" loading="eager">
                <span class="stp-hero__cap">Routines</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.stp-hero{position:relative;overflow:hidden;background:var(--stp-cream);padding:70px 0 92px;}
.stp-hero__grid{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center;position:relative;z-index:1;}
.stp-hero__copy{animation:stp-hero-rise .6s ease both;}
.stp-hero .stp-pill{margin-bottom:4px;}
.stp-hero__title{font-size:clamp(4rem,5vw,6.4rem);margin-top:20px;}
.stp-hero__title em{font-style:normal;color:var(--stp-teal-deep);}
.stp-hero__lede{font-size:1.856rem;color:var(--stp-ink-soft);margin:22px 0 30px;max-width:46ch;}
.stp-hero__ctas{display:flex;gap:14px;flex-wrap:wrap;align-items:center;}
.stp-hero__badges{display:flex;gap:12px;margin-top:34px;flex-wrap:wrap;}
.stp-hero__art{position:relative;z-index:1;animation:stp-hero-rise .7s .08s ease both;}
.stp-hero__frame{background:var(--stp-white);border-radius:32px;padding:26px;box-shadow:var(--stp-shadow-card);border:2.5px dashed var(--stp-teal);}
.stp-hero__single{border-radius:18px;width:100%;height:auto;}
.stp-hero__covers{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}
.stp-hero__cell{position:relative;aspect-ratio:4/5;border-radius:16px;overflow:hidden;padding:16px 14px 30px;display:grid;place-items:center;background:color-mix(in srgb, var(--book) 14%, white);box-shadow:var(--stp-shadow-soft);}
.stp-hero__cell img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 10px 18px rgba(46,42,50,.16));}
.stp-hero__cap{position:absolute;bottom:9px;left:0;right:0;text-align:center;font-family:var(--stp-font-display);font-weight:600;font-size:1.248rem;color:var(--book);}
.stp-hero__new{position:absolute;top:9px;right:9px;z-index:2;background:var(--book);color:#fff;font-family:var(--stp-font-display);font-size:0.96rem;padding:3px 8px;border-radius:100px;letter-spacing:.05em;}
@keyframes stp-hero-rise{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:none;}}
@media (prefers-reduced-motion:reduce){.stp-hero__copy,.stp-hero__art{animation:none;}}
@media (max-width:900px){
  .stp-hero{padding:48px 0 64px;}
  .stp-hero__grid{grid-template-columns:1fr;gap:32px;}
}
{% endstylesheet %}

{% schema %}
{
  "name": "STP Hero",
  "tag": "section",
  "class": "stp-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow pill", "default": "SLP-Created & Parent-Approved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Help your little one" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight (teal)", "default": "find their words." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Playful board books that turn everyday reading into speech practice — built by a pediatric speech-language pathologist (and mom) to move children from first sounds to full routines." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary button label", "default": "Shop the Complete Bundle" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary button link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button label", "default": "Meet the books" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary button link" },
    { "type": "header", "content": "Badges" },
    { "type": "text", "id": "badge_1", "label": "Badge 1", "default": "Perfect for Ages 0–4" },
    { "type": "text", "id": "badge_2", "label": "Badge 2", "default": "Free US shipping on bundles" },
    { "type": "header", "content": "Cover grid (default)" },
    { "type": "paragraph", "content": "Leave the single image empty to show the four-cover grid. Each cover falls back to your built-in book covers." },
    { "type": "image_picker", "id": "cover_1", "label": "Cover 1 — Imitation" },
    { "type": "image_picker", "id": "cover_2", "label": "Cover 2 — My Words" },
    { "type": "image_picker", "id": "cover_3", "label": "Cover 3 — Action" },
    { "type": "image_picker", "id": "cover_4", "label": "Cover 4 — My Routines" },
    { "type": "header", "content": "Or a single image" },
    { "type": "image_picker", "id": "single_image", "label": "Single hero image", "info": "If set, replaces the four-cover grid (e.g. the fanned-books photo)." },
    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_doodles", "label": "Show floating doodles", "default": true }
  ],
  "presets": [{ "name": "STP Hero" }]
}
{% endschema %}
