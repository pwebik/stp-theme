{%- comment %} Trust strip — 4 icon + label tiles {% endcomment -%}
<div class="home-block home-trust">
  <div class="wrap trust-grid">
    {%- for block in section.blocks -%}
      <div class="trust-item" {{ block.shopify_attributes }}>
        <div class="trust-icon" style="background:{{ block.settings.icon_bg }};">{{ block.settings.icon }}</div>
        <p>{{ block.settings.title }}</p><span>{{ block.settings.subtitle }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Home · Trust strip",
  "tag": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "👩‍⚕️" },
        { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#FCE7CF" },
        { "type": "text", "id": "title", "label": "Title", "default": "Created by an SLP" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Pediatric speech-language pathologist" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Home · Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "👩‍⚕️", "icon_bg": "#FCE7CF", "title": "Created by an SLP", "subtitle": "Pediatric speech-language pathologist" } },
        { "type": "item", "settings": { "icon": "💕", "icon_bg": "#FBE0EB", "title": "Loved by Families", "subtitle": "1,000+ five-star reviews" } },
        { "type": "item", "settings": { "icon": "🛡️", "icon_bg": "#DCF3F4", "title": "Trusted by Professionals", "subtitle": "Recommended by SLPs nationwide" } },
        { "type": "item", "settings": { "icon": "🚂", "icon_bg": "#E7E3F7", "title": "A Complete System", "subtitle": "Grows with your child, stage by stage" } }
      ]
    }
  ]
}
{% endschema %}
