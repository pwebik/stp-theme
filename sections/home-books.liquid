{%- comment %} Individual books — 4-up grid {% endcomment -%}
<section class="home-block home-books" id="books">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow coral">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="book-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.cover
          assign fallback = ''
          assign key = block.settings.title | downcase
          if key contains 'imitation'
            assign fallback = 'home-cover-imitation.webp'
          elsif key contains 'word'
            assign fallback = 'home-cover-my-words.webp'
          elsif key contains 'action'
            assign fallback = 'home-cover-action.webp'
          elsif key contains 'routine'
            assign fallback = 'home-cover-my-routines.webp'
          endif
        -%}
        <div class="book-card"{% if block.settings.highlight_border %} style="border-color:var(--yellow);"{% endif %} {{ block.shopify_attributes }}>
          <div class="book-cover-frame" style="background:linear-gradient(160deg,{{ block.settings.frame_color_1 }},{{ block.settings.frame_color_2 }});">
            {%- if block.settings.presale_flag != blank -%}<span class="presale-flag">{{ block.settings.presale_flag }}</span>{%- endif -%}
            {%- if img != blank -%}
              {{ img | image_url: width: 400 | image_tag: alt: block.settings.title }}
            {%- elsif fallback != blank -%}
              <img src="{{ fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          {%- if block.settings.kicker != blank -%}<span class="eyebrow" style="color:{{ block.settings.accent_color }};">{{ block.settings.kicker }}</span>{%- endif -%}
          <h4>{{ block.settings.title }}</h4>
          {%- if block.settings.tagline != blank -%}<p class="tagline" style="color:{{ block.settings.accent_color }};">{{ block.settings.tagline }}</p>{%- endif -%}
          {%- if block.settings.description != blank -%}<p class="desc">{{ block.settings.description }}</p>{%- endif -%}
          <div class="book-foot">
            {%- if block.settings.price != blank -%}<span class="bprice">{{ block.settings.price }}</span>{%- endif -%}
            {%- if block.settings.shop_label != blank -%}<a href="{{ block.settings.shop_link | default: '#' }}" class="bshop">{{ block.settings.shop_label }}</a>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home · Individual books",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by book" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Or start with just one." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Every book stands on its own. Start wherever your child is, and add the rest as they grow." }
  ],
  "blocks": [
    {
      "type": "book",
      "name": "Book card",
      "settings": [
        { "type": "image_picker", "id": "cover", "label": "Cover image" },
        { "type": "color", "id": "frame_color_1", "label": "Frame gradient start", "default": "#FCD9A6" },
        { "type": "color", "id": "frame_color_2", "label": "Frame gradient end", "default": "#F4901E" },
        { "type": "text", "id": "presale_flag", "label": "Presale flag (optional)" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Stage 1" },
        { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#DE7B0E" },
        { "type": "text", "id": "title", "label": "Title", "default": "Imitation Book" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Sounds & Play · Ages 6mo–2yrs" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Silly sounds and play actions that spark your toddler's very first attempts to talk." },
        { "type": "text", "id": "price", "label": "Price", "default": "$18.99" },
        { "type": "text", "id": "shop_label", "label": "Link label", "default": "Shop this book →" },
        { "type": "url", "id": "shop_link", "label": "Link" },
        { "type": "checkbox", "id": "highlight_border", "label": "Yellow border (for the new book)", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Home · Individual books",
      "blocks": [
        { "type": "book", "settings": { "frame_color_1": "#FCD9A6", "frame_color_2": "#F4901E", "kicker": "Stage 1", "accent_color": "#DE7B0E", "title": "Imitation Book", "tagline": "Sounds & Play · Ages 6mo–2yrs", "description": "Silly sounds and play actions that spark your toddler's very first attempts to talk.", "price": "$18.99", "shop_label": "Shop this book →" } },
        { "type": "book", "settings": { "frame_color_1": "#FBC7DC", "frame_color_2": "#EF4F8B", "kicker": "Stage 2", "accent_color": "#D63576", "title": "My Words Book", "tagline": "First Words · Ages 1–3yrs", "description": "First words your toddler can actually say — ball, mama, puppy, banana.", "price": "$18.99", "shop_label": "Shop this book →" } },
        { "type": "book", "settings": { "frame_color_1": "#A9E6EA", "frame_color_2": "#1F8C79", "kicker": "Stage 3", "accent_color": "#145E51", "title": "Action Book", "tagline": "Verbs & Sentences · Ages 18mo–4yrs", "description": "Verbs and -ing words that bridge single words into early sentences.", "price": "$18.99", "shop_label": "Shop this book →" } },
        { "type": "book", "settings": { "frame_color_1": "#8B7FD6", "frame_color_2": "#6E5FC4", "presale_flag": "Presale", "kicker": "Stage 4 · NEW", "accent_color": "#6E5FC4", "title": "My Routines Book", "tagline": "Everyday Routines · Ages 18mo–4yrs", "description": "Real phrases for mealtime, dressing, and play — the language of daily life at home.", "price": "$18.99", "shop_label": "Reserve yours →", "highlight_border": true } }
      ]
    }
  ]
}
{% endschema %}
