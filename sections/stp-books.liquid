{%- comment -%}  STP Books — the four-book library  {%- endcomment -%}
<section class="stp-block stp-books">
  <div class="stp-wrap">
    <div class="stp-books__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="stp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="stp-books__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="stp-btn stp-btn--teal stp-btn--sm">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>

    <div class="stp-books__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          case block.settings.color
            when 'pink'
              assign col = 'var(--stp-pink)'
            when 'red'
              assign col = 'var(--stp-red)'
            when 'purple'
              assign col = 'var(--stp-purple)'
            when 'teal'
              assign col = 'var(--stp-teal)'
            else
              assign col = 'var(--stp-orange)'
          endcase

          case block.settings.cover_key
            when 'mywords-front'
              assign fallback = 'stp-mywords-front.webp'
            when 'routines-front'
              assign fallback = 'stp-routines-front.webp'
            when 'imitation-3d'
              assign fallback = 'stp-imitation-3d.webp'
            when 'mywords-3d'
              assign fallback = 'stp-mywords-3d.webp'
            when 'action-3d'
              assign fallback = 'stp-action-3d.webp'
            when 'routines-3d'
              assign fallback = 'stp-routines-3d.webp'
            else
              assign fallback = 'stp-imitation-front.webp'
          endcase
        -%}
        <article class="stp-book-card" style="--book:{{ col }}" {{ block.shopify_attributes }}>
          <div class="stp-book-card__cover">
            {%- if block.settings.badge != blank -%}<span class="stp-book-card__badge">{{ block.settings.badge }}</span>{%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy" width="600" height="600">
            {%- else -%}
              <img src="{{ fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="600" height="600">
            {%- endif -%}
          </div>
          <div class="stp-book-card__body">
            {%- if block.settings.title != blank -%}<h3 class="stp-book-card__name">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.meta != blank -%}<div class="stp-book-card__meta">{{ block.settings.meta }}</div>{%- endif -%}
            {%- if block.settings.description != blank -%}<p class="stp-book-card__desc">{{ block.settings.description }}</p>{%- endif -%}
            <div class="stp-book-card__foot">
              {%- if block.settings.price != blank -%}<span class="stp-book-card__price">{{ block.settings.price }}</span>{%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                <a href="{{ block.settings.cta_link | default: '#' }}" class="stp-btn stp-btn--cta stp-btn--sm">{{ block.settings.cta_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.stp-books{background:var(--stp-cream);padding:88px 0;}
.stp-books__head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:40px;flex-wrap:wrap;}
.stp-books__title{font-size:clamp(2rem,3.6vw,2.8rem);margin-top:6px;}
.stp-books__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}
.stp-book-card{background:var(--stp-white);border-radius:22px;overflow:hidden;box-shadow:var(--stp-shadow-soft);
  display:flex;flex-direction:column;transition:transform .2s ease,box-shadow .2s ease;}
.stp-book-card:hover{transform:translateY(-6px);box-shadow:var(--stp-shadow-card);}
.stp-book-card__cover{position:relative;aspect-ratio:1/1;display:grid;place-items:center;padding:20px;
  background:color-mix(in srgb, var(--book) 12%, white);border-bottom:4px solid var(--book);}
.stp-book-card__cover img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 12px 22px rgba(46,42,50,.18));}
.stp-book-card__badge{position:absolute;top:14px;left:14px;z-index:2;background:var(--book);color:#fff;
  font-family:var(--stp-font-display);font-weight:600;font-size:.68rem;padding:5px 11px;border-radius:100px;letter-spacing:.03em;}
.stp-book-card__body{padding:18px 20px 22px;display:flex;flex-direction:column;gap:9px;flex:1;}
.stp-book-card__name{font-size:1.32rem;}
.stp-book-card__meta{font-size:.8rem;font-weight:600;color:var(--book);letter-spacing:.02em;}
.stp-book-card__desc{font-size:.92rem;color:var(--stp-ink-soft);flex:1;}
.stp-book-card__foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:4px;}
.stp-book-card__price{font-family:var(--stp-font-display);font-weight:600;font-size:1.18rem;}
@media (max-width:900px){.stp-books__grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:520px){.stp-books{padding:64px 0;}.stp-books__grid{grid-template-columns:1fr;}}
{% endstylesheet %}

{% schema %}
{
  "name": "STP Books",
  "tag": "section",
  "class": "stp-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The library" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the books" },
    { "type": "text", "id": "cta_label", "label": "Header button label", "default": "Save more with a bundle →" },
    { "type": "url", "id": "cta_link", "label": "Header button link" }
  ],
  "blocks": [
    {
      "type": "book",
      "name": "Book",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Imitation Book" },
        { "type": "text", "id": "meta", "label": "Meta line", "default": "Ages 0–3 · Sounds" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Copy sounds, gestures, and playful prompts — the joyful first step to talking." },
        { "type": "text", "id": "price", "label": "Price", "default": "$15.99" },
        { "type": "text", "id": "badge", "label": "Corner badge", "info": "Leave blank for none." },
        { "type": "select", "id": "color", "label": "Accent color", "default": "orange",
          "options": [
            { "value": "orange", "label": "Orange" },
            { "value": "pink", "label": "Pink" },
            { "value": "red", "label": "Red" },
            { "value": "purple", "label": "Purple" },
            { "value": "teal", "label": "Teal" }
          ]
        },
        { "type": "select", "id": "cover_key", "label": "Built-in cover", "default": "imitation-front",
          "info": "Used when no custom image is set below.",
          "options": [
            { "value": "imitation-front", "label": "Imitation (front)" },
            { "value": "mywords-front", "label": "My Words (front)" },
            { "value": "routines-front", "label": "My Routines (front)" },
            { "value": "imitation-3d", "label": "Imitation (3D)" },
            { "value": "mywords-3d", "label": "My Words (3D)" },
            { "value": "action-3d", "label": "Action (3D)" },
            { "value": "routines-3d", "label": "My Routines (3D)" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "Custom cover image (optional)" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add" },
        { "type": "url", "id": "cta_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "STP Books",
      "blocks": [
        { "type": "book", "settings": { "title": "Imitation Book", "meta": "Ages 0–3 · Sounds", "description": "Copy sounds, gestures, and playful prompts — the joyful first step to talking.", "price": "$15.99", "color": "orange", "cover_key": "imitation-front", "cta_label": "Add" } },
        { "type": "book", "settings": { "title": "My Words Book", "meta": "Ages 1–4 · Words", "description": "Only clear, functional first words toddlers are most likely to say and use daily.", "price": "$15.99", "color": "pink", "cover_key": "mywords-front", "cta_label": "Add" } },
        { "type": "book", "settings": { "title": "Action Book", "meta": "Ages 1–4 · Sentences", "description": "Simple verbs that help toddlers move beyond labeling and start forming sentences.", "price": "$15.99", "color": "red", "cover_key": "action-3d", "cta_label": "Add" } },
        { "type": "book", "settings": { "title": "My Routines Book", "meta": "Ages 1–4 · Routines", "description": "Everyday phrases woven into bath, meals, and bedtime — the newest stage.", "price": "$15.99", "badge": "Presale", "color": "purple", "cover_key": "routines-front", "cta_label": "Reserve" } }
      ]
    }
  ]
}
{% endschema %}
