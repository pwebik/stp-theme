{%- comment %} Curated review cards {% endcomment -%}
<section class="home-block home-reviews" id="reviews">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color:var(--teal-deep);">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="review-grid">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="stars">{{ block.settings.stars }}</div>
          <p>{{ block.settings.quote }}</p>
          <div class="review-foot">
            <div class="avatar" style="background:{{ block.settings.avatar_color }};">{{ block.settings.avatar_letter }}</div>
            <div>
              <div class="name">{{ block.settings.name }}</div>
              <div class="role">{{ block.settings.role }}</div>
            </div>
          </div> 
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home · Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From real families" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "1,000+ five-star reviews" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Recommended by speech therapists. Loved by parents and grandparents." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "\"This book helped my baby start to talk and say words at 12 months old. It's now part of our daily routine.\"" },
        { "type": "text", "id": "avatar_letter", "label": "Avatar letter", "default": "K" },
        { "type": "color", "id": "avatar_color", "label": "Avatar colour", "default": "#F4901E" },
        { "type": "text", "id": "name", "label": "Name", "default": "Krizzy" },
        { "type": "text", "id": "role", "label": "Role", "default": "Verified buyer" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Home · Reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "\"This book helped my baby start to talk and say words at 12 months old. It's now part of our daily routine.\"", "avatar_letter": "K", "avatar_color": "#F4901E", "name": "Krizzy", "role": "Verified buyer" } },
        { "type": "review", "settings": { "quote": "\"As a parent, finding tools that actually help your child's development can feel overwhelming. This is one of those rare finds that delivers.\"", "avatar_letter": "A", "avatar_color": "#1F8C79", "name": "Amazon Customer", "role": "Verified purchase" } },
        { "type": "review", "settings": { "quote": "\"Speech path here. I love this book. It was one of my son's favorites and what I used to help him produce more words from 1–2 years.\"", "avatar_letter": "B", "avatar_color": "#EF4F8B", "name": "Brooke", "role": "SLP & mom" } }
      ]
    }
  ]
}
{% endschema %}
