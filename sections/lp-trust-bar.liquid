{%- capture lp_bg_decls -%}{%- if section.settings.bg_image != blank -%}{%- assign lp_ov = section.settings.bg_overlay | default: 0 | divided_by: 100.0 -%}background-image: linear-gradient(rgba(255,255,255,{{ lp_ov }}),rgba(255,255,255,{{ lp_ov }})), url('{{ section.settings.bg_image | image_url: width: 2400 }}'); background-size: cover; background-position: center; background-repeat: no-repeat;{%- endif -%}{%- endcapture -%}
{%- comment -%}
  Landing Page: Trust Bar
  Three icon + label items, sit just below the hero.
{%- endcomment -%}

<section{% if section.settings.bg_image != blank %} style="{{ lp_bg_decls }}"{% endif %} class="trust-bar">
  {%- for block in section.blocks -%}
    {%- if forloop.index > 1 -%}<div class="trust-divider"></div>{%- endif -%}
    <div class="trust-item" {{ block.shopify_attributes }}>
      <span class="icon">{{ block.settings.icon }}</span>
      <span class="label">{{ block.settings.label }}</span>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "LP Trust Bar",
  "tag": "section",
  "class": "lp-section lp-section--trust",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add 2–4 trust items. Drag to reorder."
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "bg_overlay",
      "label": "White overlay",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "info": "0 = image at full strength, higher = more white wash for text legibility."
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "info": "Use a single emoji. Examples: 👩‍⚕️ 💕 🛡️ ⭐",
          "default": "💕"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Loved by Families"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "LP Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "👩‍⚕️",
            "label": "Created by an SLP"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "💕",
            "label": "Loved by Families"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "🛡️",
            "label": "Trusted by Professionals"
          }
        }
      ]
    }
  ]
}
{% endschema %}
