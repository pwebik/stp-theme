{%- comment %} Brand video — upload the full-res video to Shopify and pick it here {% endcomment -%}
<section class="home-block home-video">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow coral">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="brand-video-frame">
      {%- assign v = section.settings.video -%}
      {%- if v != blank -%}
        <video
          {% if section.settings.autoplay %}autoplay muted{% elsif section.settings.muted %}muted{% endif %}
          {% if section.settings.loop %}loop{% endif %}
          {% if section.settings.show_controls %}controls{% endif %}
          playsinline
          {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 720 }}"{% else %}poster="{{ 'home-video-poster.jpg' | asset_url }}"{% endif %}>
          {%- for source in v.sources -%}
            {%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="video/mp4">{%- endif -%}
          {%- endfor -%}
        </video>
      {%- else -%}
        <img src="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 720 }}{% else %}{{ 'home-video-poster.jpg' | asset_url }}{% endif %}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    {%- if section.settings.caption != blank -%}<p class="brand-video-caption">{{ section.settings.caption }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home · Brand video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See it in action" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One system, every stage of talking." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "From first sounds to everyday routines — a quick look at how the books work together." },
    { "type": "video", "id": "video", "label": "Video", "info": "Upload the full-resolution video to Shopify, then select it here. Do not commit large video files to the theme." },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "🔊 Tap to unmute" },
    { "type": "header", "content": "Playback" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay (forces muted)", "default": true },
    { "type": "checkbox", "id": "muted", "label": "Muted", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": true },
    { "type": "checkbox", "id": "show_controls", "label": "Show controls", "default": true }
  ],
  "presets": [ { "name": "Home · Brand video" } ]
}
{% endschema %}
