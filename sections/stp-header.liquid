{%- comment %} Speech Therapy Publishing — brand header (matches Genesis mockup) {% endcomment -%}
<header class="stp-header">
  <div class="stp-nav-inner">
    <a href="{{ routes.root_url }}" class="stp-logo">
      {%- if section.settings.logo_image != blank -%}
        {{ section.settings.logo_image | image_url: width: 300 | image_tag: alt: shop.name, class: 'stp-logo-img' }}
      {%- else -%}
        <span class="stp-logo-dot" aria-hidden="true"></span>{{ section.settings.logo_text }} <em>{{ section.settings.logo_text_accent }}</em>
      {%- endif -%}
    </a>

    <input type="checkbox" id="stp-nav-toggle" class="stp-nav-toggle" hidden>
    <label for="stp-nav-toggle" class="stp-burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="stp-links" aria-label="Primary">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="stp-nav-cta">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.show_cart -%}
        <a href="{{ routes.cart_url }}" class="stp-cart">Cart{% if cart.item_count > 0 %} <span class="stp-cart-count">{{ cart.item_count }}</span>{% endif %}</a>
      {%- endif -%}
    </nav>
  </div>
</header>

{% stylesheet %}
.stp-header { background: var(--cream, #FDF3E2); border-bottom: 1px solid var(--line, rgba(43,36,64,0.1)); position: sticky; top: 0; z-index: 50; }
.stp-nav-inner { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; max-width: 1200px; margin: 0 auto; gap: 20px; }
.stp-logo { display: flex; align-items: center; gap: 10px; font-family: var(--font-heading-family); font-weight: 700; font-size: 19px; color: var(--ink, #262138); text-decoration: none; white-space: nowrap; }
.stp-logo-img { height: 34px; width: auto; display: block; }
.stp-logo-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--coral, #F4901E); flex: none; }
.stp-logo em { font-style: normal; color: var(--coral-deep, #DE7B0E); }
.stp-links { display: flex; gap: 32px; align-items: center; }
.stp-links a { font-weight: 700; font-size: 14.5px; color: var(--ink-soft, #635D74); text-decoration: none; }
.stp-links a:hover { color: var(--ink, #262138); }
.stp-nav-cta { background: var(--ink, #262138); color: var(--white, #fff) !important; padding: 11px 22px; border-radius: 100px; font-weight: 700; font-size: 14px; }
.stp-nav-cta:hover { background: var(--teal-deep, #145E51); }
.stp-cart { display: inline-flex; align-items: center; gap: 6px; }
.stp-cart-count { background: var(--coral, #F4901E); color: #fff; border-radius: 100px; padding: 1px 8px; font-size: 12px; }
.stp-burger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 6px; }
.stp-burger span { width: 24px; height: 2px; background: var(--ink, #262138); border-radius: 2px; }
@media (max-width: 980px) {
  .stp-burger { display: flex; }
  .stp-links { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--cream, #FDF3E2); flex-direction: column; align-items: flex-start; gap: 18px; padding: 20px 24px; border-bottom: 1px solid var(--line, rgba(43,36,64,0.1)); box-shadow: var(--shadow-soft, 0 20px 45px -20px rgba(43,36,64,0.25)); }
  .stp-nav-toggle:checked ~ .stp-links { display: flex; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "STP Header",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Logo image (optional — overrides text logo)" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "speech therapy" },
    { "type": "text", "id": "logo_text_accent", "label": "Logo text (accent)", "default": "publishing" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Shop Bundles" },
    { "type": "url", "id": "cta_link", "label": "CTA button link" },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart link", "default": true }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
