{%- comment -%}
  STP decorative doodle — inline SVG in the brand style.
  Recreated to match the flourishes on the brand graphics (stars, hearts,
  crescents, swirls, sparkles, notes). Scalable + recolorable, no extra requests.

  Usage:
    {% render 'stp-doodle', type:'star', color:'var(--stp-yellow)', size:42,
              float:'stp-float', style:'top:12%;left:5%;--r:-8deg' %}

  Params:
    type   star | heart | crescent | swirl | sparkle | note | dot   (default star)
    color  any CSS color / var                                     (default currentColor)
    size   px                                                       (default 40)
    float  '' | stp-float | stp-float stp-float--slow | ...--fast   (default '')
    style  extra inline CSS (positioning, --r rotation)             (default '')
    class  extra classes                                            (default '')
{%- endcomment -%}
{%- liquid
  assign t = type | default: 'star'
  assign c = color | default: 'currentColor'
  assign s = size | default: 40
  assign fl = float | default: ''
-%}
<span class="stp-doodle {{ fl }} {{ class }}" style="width:{{ s }}px;height:{{ s }}px;{{ style }}" aria-hidden="true">
{%- case t -%}
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}"><path d="M12 2.2l2.5 6.3 6.8.4-5.2 4.4 1.7 6.6L12 16.7 6.4 20.3l1.7-6.6-5.2-4.4 6.8-.4z" fill="{{ c }}"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}"><path d="M12 21s-7.3-4.6-9.4-9.2C1.2 8.5 3 5.4 6.1 5.4c1.9 0 3.3 1.1 4 2.3.7-1.2 2.1-2.3 4-2.3 3.1 0 4.9 3.1 3.5 6.4C19.3 16.4 12 21 12 21z" fill="{{ c }}"/></svg>
  {%- when 'crescent' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}"><path d="M16.5 3a9 9 0 100 18 7 7 0 010-18z" fill="{{ c }}"/></svg>
  {%- when 'swirl' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none"><path d="M3 12c0-3 2.2-5 4.7-5 2 0 3.3 1.5 3.3 3.2 0 1.4-1 2.3-2.1 2.3-.9 0-1.5-.6-1.5-1.3M21 12c0 3-2.2 5-4.7 5-2 0-3.3-1.5-3.3-3.2 0-1.4 1-2.3 2.1-2.3.9 0 1.5.6 1.5 1.3" stroke="{{ c }}" stroke-width="2.4" stroke-linecap="round"/></svg>
  {%- when 'sparkle' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}"><path d="M12 2c.6 4.6 2.4 6.4 8 7-5.6.6-7.4 2.4-8 7-.6-4.6-2.4-6.4-8-7 5.6-.6 7.4-2.4 8-7z" fill="{{ c }}"/></svg>
  {%- when 'note' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}"><path d="M9 17.5a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0zM9 17.5V6l10-2v9.5" fill="none" stroke="{{ c }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M19 15.5a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" fill="{{ c }}"/></svg>
  {%- when 'dot' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}"><circle cx="12" cy="12" r="9" fill="{{ c }}"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}"><path d="M12 2.2l2.5 6.3 6.8.4-5.2 4.4 1.7 6.6L12 16.7 6.4 20.3l1.7-6.6-5.2-4.4 6.8-.4z" fill="{{ c }}"/></svg>
{%- endcase -%}
</span>
